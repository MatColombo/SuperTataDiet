{
  "schema_version": 1,
  "policy_version": "6.0.0-phase-c1.1",
  "name": "TataDiet V6 Phase C.1 - diversity and purchase reuse policy",
  "intent": "Increase real ingredient diversity without creating wasteful one-off purchases. Preserve all Phase A/C hard and soft dietary gates.",
  "explicit_exclusions": [
    "tofu",
    "tempeh",
    "seitan"
  ],
  "principles": {
    "fixed_recipe_portions_only": true,
    "prefer_existing_simple_ingredients": true,
    "do_not_create_singleton_specialty_ingredients": true,
    "reuse_same_purchase_in_different_recipes": true,
    "do_not_trade_one_monoculture_for_another": true,
    "seasonality_remains_binding_for_curation": true
  },
  "global_variety_targets": {
    "max_recipe_family_occurrences_180d": 12,
    "max_banana_meals": 55,
