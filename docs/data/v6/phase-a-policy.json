      "max_per_window": 6.0,
      "ingredients": {
        "uovo": {
          "grams_per_unit": 50.0
        },
        "albume": {
          "grams_per_unit": 50.0
        }
      },
      "note": "Product-policy equivalence for planning: 50 g whole egg or 50 g egg white = 1 egg-equivalent unit. This is a scheduling rule, not a clinical conversion."
    },
